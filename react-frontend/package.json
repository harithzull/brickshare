{
  "name": "brickshare-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run typecheck:api && node --test test/*.test.mjs",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "dev": "vite",
    "dev:testnet": "vite --mode testnet",
    "build": "npm run typecheck:api && vite build",
    "build:testnet": "npm run typecheck:api && vite build --mode testnet",
    "preview": "vite preview"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "ethers": "^5.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "siwe": "3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.9.3",
    "vite": "^5.1.0"
  }
}
