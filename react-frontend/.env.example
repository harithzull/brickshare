# Public browser configuration only. Copy to .env.local for local development.
# Never put private keys, explorer keys, or privileged RPC credentials here.
VITE_NETWORK=localhost
VITE_RPC_URL=http://127.0.0.1:8545
# Leave blank to use the matching generated localhost deployment record.
VITE_CONTRACT_ADDRESS=
VITE_DEPLOYMENT_BLOCK=
# Optional public API origin; blank keeps standalone RPC browsing.
# For wallet sign-in, open http://127.0.0.1:5173 and match API AUTH_ORIGIN.
# SameSite auth cookies require the same hostname/scheme on frontend and API.
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_API_TIMEOUT_MS=3000
VITE_API_MAX_AGE_MS=30000
VITE_API_POLL_MS=15000
