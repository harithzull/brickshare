# Copy to .env.testnet.local for npm run dev:testnet / npm run build:testnet.
# Alternatively set these public values in your static host's build settings.
VITE_NETWORK=baseSepolia
VITE_RPC_URL=https://sepolia.base.org
# Use your actual deployed contract and its receipt block. Leave blank only
# when the reviewed deployments/baseSepolia.json record is committed.
VITE_CONTRACT_ADDRESS=
VITE_DEPLOYMENT_BLOCK=
# Everything prefixed VITE_ is publicly readable in the built website.
