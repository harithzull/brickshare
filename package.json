{
  "name": "brickshare",
  "version": "0.1.0",
  "private": true,
  "description": "Local real estate tokenization demo with Solidity and React",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev:indexer": "npm --prefix apps/api run worker:dev",
    "start:indexer": "npm --prefix apps/api run worker:start",
    "indexer:once": "npm --prefix apps/api run worker:once",
    "test:indexer:live": "npm --prefix apps/api run test:indexer:live",
    "setup:api": "npm ci --prefix apps/api",
    "dev:api": "npm --prefix apps/api run dev",
    "build:api": "npm --prefix apps/api run build",
    "start:api": "npm --prefix apps/api start",
    "test:api": "npm --prefix apps/api test",
    "test:api:db": "npm --prefix apps/api run test:db",
    "db:migrate": "npm --prefix apps/api run db:migrate",
    "db:revert": "npm --prefix apps/api run db:revert",
    "db:seed:networks": "npm --prefix apps/api run db:seed:networks",
    "db:seed:fictional": "npm --prefix apps/api run db:seed:fictional",
    "setup": "npm ci && npm ci --prefix react-frontend",
    "compile": "hardhat compile && node scripts/sync-frontend.js",
    "test": "hardhat test",
    "test:frontend": "npm --prefix react-frontend test",
    "test:config": "node --test scripts/tests/*.test.cjs",
    "test:integration": "node scripts/tests/local-deployment-smoke.cjs",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "verify:base-sepolia": "hardhat run scripts/verify.js --network baseSepolia",
    "dev": "npm --prefix react-frontend run dev",
    "dev:testnet": "npm --prefix react-frontend run dev:testnet",
    "build": "npm --prefix react-frontend run build",
    "build:testnet": "npm --prefix react-frontend run build:testnet",
    "preview": "npm --prefix react-frontend run preview"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "hardhat": "^2.22.19",
    "hardhat-gas-reporter": "^2.3.0"
  }
}
