# Copy to apps/api/.env; fill local credentials in your editor. Never commit it.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Use one consistent password here and in POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://brickshare:CHANGE_ME@127.0.0.1:5433/brickshare
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_CONNECT_TIMEOUT_MS=2000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Wallet login: open the frontend at this exact origin (ports matter).
# Frontend and API must use matching hostnames/schemes for SameSite cookies.
AUTH_ORIGIN=http://127.0.0.1:5173
AUTH_CHAIN_IDS=31337
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=3600
# false is for loopback HTTP only. HTTPS requires true (__Host- cookies).
AUTH_COOKIE_SECURE=false
# Explicit operator-only development bootstrap; never grant deployers implicitly.
ALLOW_LOCAL_ADMIN_BOOTSTRAP=false
# Optional public asset origin. Files are not served/uploaded by this API.
ASSET_PUBLIC_BASE_URL=
ALLOW_FICTIONAL_SEED=false
# Docker Compose only; supply your own local password. No signing keys needed.
POSTGRES_USER=brickshare
POSTGRES_PASSWORD=
POSTGRES_DB=brickshare
POSTGRES_PORT=5433
# Database tests require a separate disposable database whose name ends in _test.
TEST_DATABASE_URL=
# Optional local-only worker; no signing keys. Paths are relative to repo root.
INDEXER_RPC_URL=http://127.0.0.1:8545
INDEXER_CHAIN_ID=31337
INDEXER_DEPLOYMENT_FILE=react-frontend/src/generated/deployment.json
INDEXER_ARTIFACT_FILE=artifacts/contracts/RealEstateTokenization.sol/RealEstateTokenization.json
INDEXER_POLL_MS=2000
INDEXER_RPC_TIMEOUT_MS=5000
INDEXER_BATCH_SIZE=25
INDEXER_REORG_DEPTH=64
INDEXER_MAX_PROPERTIES=1000
INDEXER_MAX_EVENTS=100000
INDEXER_STALE_AFTER_MS=30000
# Explicit one-time acknowledgement after a local reset. Return to false after rebind.
INDEXER_ALLOW_LOCAL_REBIND=false
# Optional reviewed Git SHA/tag; blank means unknown, never inferred.
INDEXER_RELEASE_REFERENCE=
