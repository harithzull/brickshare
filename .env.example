# Deployment tooling only. Copy to root .env; never commit the populated file.
# Use a dedicated testnet wallet, funded only with Base Sepolia test ETH.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
# Etherscan V2 API key used only for source verification, not frontend hosting.
ETHERSCAN_API_KEY=
# Optional localhost override; defaults to http://127.0.0.1:8545.
# LOCALHOST_RPC_URL=http://127.0.0.1:8545
